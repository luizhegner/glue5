--!strict
-- More places to go, by kind, from the open-source trainers' published lists (Menyoo, Enhanced
-- Native Trainer, Lambda Menu, Foxy, ag-admin), the base game's only: each was tried in this
-- game (the player lands on ground or a floor). Some need IPLs loaded (`load`) or removed
-- (`unload`), an interior enabled (`interior`), or GTA Online's map (`online`: there only).

export type Options = { load: { string }?, unload: { string }?, interior: boolean?, online: boolean? }
export type Place = { name: string, x: number, y: number, z: number, heading: number, options: Options? }
export type Kind = { name: string, places: { Place } }

local function at(name: string, x: number, y: number, z: number, heading: number, options: Options?): Place
	return { name = name, x = x, y = y, z = z, heading = heading, options = options }
end

