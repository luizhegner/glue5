@@ -620,6 +620,22 @@ pub(crate) struct InnerCommandEncoder {
     /// [`wgpu_hal::CommandEncoder`]: hal::CommandEncoder
     pub(crate) is_open: bool,
 
+    /// True if the last command buffer in `list` was suspended, not ended
+    /// ([`hal::CommandEncoder::suspend_encoding`]): recording can resume
+    /// into it instead of beginning another command buffer.
+    ///
+    /// A pass's command buffer is suspended at its end, and the barriers
+    /// before the next pass go at the end of it, where they run in the same
+    /// order as in a command buffer of their own between the two: one
+    /// command buffer per pass, not two. Command buffers have a cost of
+    /// their own on some platforms (each holds ~0.4 MB of host memory on
+    /// Mali; Metal hands each to the kernel and releases it after).
+    pub(crate) last_suspended: bool,
+
+    /// While a pass's barriers are being recorded ([`Self::open_before_pass`]):
+    /// true if the command buffer before the pass's was suspended.
+    pub(crate) suspended_before_pass: bool,
+
     /// Tracks which API is being used to encode commands.
     ///
     /// Mixing the wgpu encoding API with access to the raw hal encoder via
@@ -725,6 +741,7 @@ impl InnerCommandEncoder {
     /// [l]: InnerCommandEncoder::list
     pub(crate) fn close(&mut self) -> Result<(), DeviceError> {
         assert!(self.is_open);
+        debug_assert!(!self.last_suspended);
         self.is_open = false;
 
         let cmd_buf =
@@ -745,6 +762,36 @@ impl InnerCommandEncoder {
     ///
     /// [l]: InnerCommandEncoder::list
     fn close_if_open(&mut self) -> Result<(), DeviceError> {
+        if self.is_open {
+            self.is_open = false;
+            let suspend = self.raw.can_suspend();
+            let cmd_buf = if suspend {
+                unsafe { self.raw.suspend_encoding() }
+            } else {
+                unsafe { self.raw.end_encoding() }
+            }
+            .map_err(|e| self.device.handle_hal_error(e))?;
+            self.list.push(cmd_buf);
+            self.last_suspended = suspend;
+        }
+
+        Ok(())
+    }
+
+    /// Finish every command buffer: the open one, if any, and the last
+    /// one in [`self.list`][l] if it was only suspended. Nothing recorded
+    /// later goes before what is in the list now.
+    ///
+    /// On return, the underlying hal encoder is closed.
+    ///
+    /// [l]: InnerCommandEncoder::list
+    pub(crate) fn seal(&mut self) -> Result<(), DeviceError> {
+        if !self.is_open && self.last_suspended {
+            let cmd_buf = self.list.pop().unwrap();
+            unsafe { self.raw.resume_encoding(cmd_buf) };
+            self.is_open = true;
+        }
+        self.last_suspended = false;
         if self.is_open {
             self.is_open = false;
             let cmd_buf =
@@ -755,6 +802,72 @@ impl InnerCommandEncoder {
         Ok(())
     }
 
+    /// Put the raw encoder in the "recording" state: resume the last
+    /// command buffer if it was suspended, or begin another.
+    fn begin_or_resume(&mut self) -> Result<(), DeviceError> {
+        if self.last_suspended {
+            let cmd_buf = self.list.pop().unwrap();
+            unsafe { self.raw.resume_encoding(cmd_buf) };
+            self.last_suspended = false;
+        } else {
+            let hal_label = hal_label(Some(self.label.as_str()), self.device.instance_flags);
+            unsafe { self.raw.begin_encoding(hal_label) }
+                .map_err(|e| self.device.handle_hal_error(e))?;
+        }
+        self.is_open = true;
+        Ok(())
+    }
+
+    /// Finish a render or compute pass's command buffer, suspended if the
+    /// raw encoder can: [`Self::open_before_pass`] then records the pass's
+    /// barriers at the end of the command buffer before it, if that one
+    /// was suspended too, and the next commands can go at the end of this
+    /// one.
+    ///
+    /// On return, the underlying hal encoder is closed.
+    pub(crate) fn close_pass(&mut self) -> Result<(), DeviceError> {
+        assert!(self.is_open);
+        self.is_open = false;
+        let suspend = self.raw.can_suspend();
+        let cmd_buf = if suspend {
+            unsafe { self.raw.suspend_encoding() }
+        } else {
+            unsafe { self.raw.end_encoding() }
+        }
+        .map_err(|e| self.device.handle_hal_error(e))?;
+        self.suspended_before_pass = self.last_suspended;
+        self.list.push(cmd_buf);
+        self.last_suspended = suspend;
+        Ok(())
+    }
+
+    /// Begin recording what must run just before the pass that
+    /// [`Self::close_pass`] closed (its barriers): at the end of the command
+    /// buffer before the pass's, if it was suspended, or in a new one.
+    /// [`Self::close_before_pass`] puts it in place.
+    pub(crate) fn open_before_pass(
+        &mut self,
+        label: Option<&str>,
+    ) -> Result<&mut dyn hal::DynCommandEncoder, DeviceError> {
+        assert!(!self.is_open);
+        if self.suspended_before_pass {
+            let cmd_buf = self.list.remove(self.list.len() - 2);
+            unsafe { self.raw.resume_encoding(cmd_buf) };
+            self.is_open = true;
+            Ok(self.raw.as_mut())
+        } else {
+            self.open_pass(label)
+        }
+    }
+
+    /// End the command buffer [`Self::open_before_pass`] opened and put it
+    /// just before the pass's, which stays last. It is not resumed again:
+    /// the pass follows it.
+    pub(crate) fn close_before_pass(&mut self) -> Result<(), DeviceError> {
+        self.suspended_before_pass = false;
+        self.close_and_swap()
+    }
+
     /// If the command encoder is not open, begin recording a new command buffer.
     ///
     /// If the command encoder was already open, does nothing.
@@ -762,10 +875,7 @@ impl InnerCommandEncoder {
