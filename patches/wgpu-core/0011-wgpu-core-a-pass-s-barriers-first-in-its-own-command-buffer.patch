     let encoder = &mut parent_state.raw_encoder;
     let tracker = &mut parent_state.tracker;
 
+    // glue5: the pass's barriers went just before it, in the command buffer
+    // that stays open for what comes next: the tracker already holds what
+    // the pass uses (the same usages, the scan
+    // covering them all), and applying them again would add barriers (a
